{
  "name": "@gavin-hu/my-pi-agent",
  "version": "0.22.0",
  "description": "Personal Pi customizations, packaged as a Pi package: worktree isolation and rewind snapshots, question, todo, goal, plan, serve, subagent, job, watch, web-access, file-browse, file-open, file-read, check, memory, context, session-bus, board, team, wechat, and bytefly.",
  "keywords": [
    "pi-package",
    "pi",
    "git",
    "worktree",
    "todo",
    "goal",
    "objective",
    "plan",
    "question",
    "init",
    "agents-md",
    "refactor",
    "skill",
    "subagent",
    "agents",
    "delegation",
    "rewind",
    "snapshot",
    "undo",
    "job",
    "jobs",
    "background",
    "process",
    "watch",
    "tail",
    "log",
    "alert",
    "pattern",
    "file-browse",
    "browse",
    "browser",
    "file-open",
    "open",
    "open_path",
    "reveal",
    "doc",
    "file-read",
    "doctor",
    "diagnostics",
    "prerequisites",
    "pdf",
    "docx",
    "xlsx",
    "excel",
    "read_doc",
    "memory",
    "board",
    "cards",
    "backlog",
    "team",
    "handoff",
    "assign",
    "cross-session",
    "context",
    "compaction",
    "tokens",
    "wechat",
    "web-access",
    "bytefly",
    "footer",
    "separator",
    "transcript",
    "check",
    "test",
    "lint",
    "typecheck",
    "verification"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Gavin Hu",
  "repository": {
    "type": "git",
    "url": "https://github.com/gavin-hu/my-pi-agent.git"
  },
  "files": [
    "extensions/**",
    "docs/extensions/**",
    "lib/**",
    "skills/**",
    "themes/**",
    "assets/screens/board.png",
    "assets/screens/chrome.png",
    "assets/screens/file-browse.png",
    "assets/screens/plan-review.png",
    "assets/screens/plan.png",
    "!**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pi": {
    "extensions": [
      "./extensions/serve/index.ts",
      "./extensions/worktree/index.ts",
      "./extensions/rewind/index.ts",
      "./extensions/question/index.ts",
      "./extensions/todo/index.ts",
      "./extensions/goal/index.ts",
      "./extensions/plan/index.ts",
      "./extensions/check/index.ts",
      "./extensions/subagent/index.ts",
      "./extensions/job/index.ts",
      "./extensions/watch/index.ts",
      "./extensions/web-access/index.ts",
      "./extensions/file-browse/index.ts",
      "./extensions/file-read/index.ts",
      "./extensions/file-open/index.ts",
      "./extensions/memory/index.ts",
      "./extensions/context/index.ts",
      "./extensions/board/index.ts",
      "./extensions/team/index.ts",
      "./extensions/session-bus/index.ts",
      "./extensions/wechat/index.ts",
      "./extensions/bytefly/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes/*.json"
    ],
    "image": "https://raw.githubusercontent.com/gavin-hu/my-pi-agent/main/assets/screens/chrome.png"
  },
  "scripts": {
    "test": "bun test --parallel=4 --timeout 30000",
    "test:serial": "bun test --timeout 30000",
    "test:watch": "bun test --watch --isolate --timeout 30000",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:static": "bun run format:check && bun run typecheck",
    "check": "bun run check:static && bun run test",
    "check:serial": "bun run check:static && bun run test:serial",
    "release:notes": "bun run scripts/release-notes.ts",
    "config:migrate": "bun run scripts/migrate-config.ts",
    "compat:versions": "bun run scripts/peer-versions.ts",
    "bench:render": "bun run scripts/render-bench.ts",
    "screenshot:board": "bun run scripts/shots/board.ts",
    "screenshot:cards": "bun run scripts/shots/cards.ts",
    "screenshot:file-browse": "bun run scripts/shots/file-browse.ts",
    "screenshot:plan": "bun run scripts/shots/plan-review.ts",
    "screenshot:tools": "bun run tools:render gallery assets/screens/tool-renderings.png",
    "screenshot:tool-pngs": "bun run tools:render tools assets/tools",
    "probe:wechat": "bun run scripts/wechat-poll.ts",
    "screenshots": "bun run scripts/screenshots.ts",
    "tools:render": "bun run scripts/tools/index.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "qrcode": "^1.5.4",
    "rtf-parser": "^1.3.3",
    "unpdf": "^1.8.1",
    "word-extractor": "^1.0.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/bun": "latest",
    "@types/qrcode": "^1.5.5",
    "get-east-asian-width": "^1.6.0",
    "playwright-core": "^1.64.1",
    "typebox": "^1.4.3",
    "typescript": "^5.6.0"
  }
}
