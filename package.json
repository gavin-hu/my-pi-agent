{
  "name": "@gavin-hu/my-pi-agent",
  "version": "0.4.0",
  "description": "Personal Pi customizations, packaged as a Pi package: worktree, ask-user-question, todo, goal, git, rewind, plan-mode, subagent, jobs, web-search, web-fetch, file-browser, status-bar, and turn-separator.",
  "keywords": [
    "pi-package",
    "pi",
    "git",
    "worktree",
    "todo",
    "goal",
    "objective",
    "plan",
    "subagent",
    "agents",
    "delegation",
    "rewind",
    "snapshot",
    "undo",
    "jobs",
    "background",
    "process",
    "file-browser",
    "serve",
    "browser",
    "status-bar",
    "footer",
    "turn-separator",
    "separator",
    "transcript"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Gavin Hu",
  "repository": {
    "type": "git",
    "url": "https://github.com/gavin-hu/my-pi-agent.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/worktree/index.ts",
      "./extensions/ask-user-question/index.ts",
      "./extensions/todo/index.ts",
      "./extensions/goal/index.ts",
      "./extensions/git/index.ts",
      "./extensions/rewind/index.ts",
      "./extensions/plan-mode/index.ts",
      "./extensions/subagent/index.ts",
      "./extensions/jobs/index.ts",
      "./extensions/web-search/index.ts",
      "./extensions/web-fetch/index.ts",
      "./extensions/file-browser/index.ts",
      "./extensions/status-bar/index.ts",
      "./extensions/turn-separator/index.ts"
    ],
    "themes": [
      "./themes/*.json"
    ],
    "image": "./assets/screenshot.jpg"
  },
  "files": [
    "extensions",
    "themes",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test --isolate --timeout 30000",
    "test:watch": "bun test --watch --isolate",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "transpile": "bun run scripts/transpile.ts",
    "smoke": "bun run scripts/smoke-runtime.ts",
    "e2e:rewind": "bun run scripts/rewind-e2e.ts",
    "check": "bun run format:check && bun run typecheck && bun run transpile && bun run test && bun run smoke && bun run e2e:rewind"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@earendil-works/pi-agent-core": "^1.0.4",
    "@earendil-works/pi-ai": "^1.0.4",
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@earendil-works/pi-tui": "^1.0.4",
    "@types/bun": "latest",
    "typebox": "^1.3.27",
    "typescript": "^5.6.0"
  }
}
